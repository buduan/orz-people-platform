{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": false,
    "noEmit": true,
    "paths": {
      "@orz-people-platform/utils": [
        "packages/utils/src"
      ],
      "~/*": [
        "app/frontend/*"
      ],
      "~~/*": [
        "app/frontend/*"
      ]
    }
  },
  "include": [
    "app/backend/src/**/*.ts",
    "app/backend/*.ts",
    "app/frontend/**/*.ts",
    "app/frontend/**/*.vue",
    "packages/**/*.ts"
  ]
}
