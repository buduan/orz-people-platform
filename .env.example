# For Development
NODE_ENV=development
PORT=6770
NUXT_PORT=6771
WORKER_HEALTH_PORT=6772

# Public/auth origins and credentials. APP_ORIGIN must equal the frontend
# origin so the Better Auth session cookie is same-site and the origin check
# passes (the browser calls /api/auth on the frontend, which proxies to 6770).
APP_ORIGIN=https://opp.ibuduan.com
API_ORIGIN=https://api.opp.ibuduan.com
PASSKEY_ORIGIN=https://opp.ibuduan.com
PASSKEY_RP_ID=opp.ibuduan.com
BETTER_AUTH_SECRET=example-only-secret-with-at-least-32-characters
MASTER_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Application ports exposed by Docker Compose
BACKEND_PORT=6770
FRONTEND_PORT=6771

# Frontend dev proxy target: Nuxt forwards /api/** here (see nuxt.config.ts).
BACKEND_ORIGIN=https://api.opp.ibuduan.com

# PostgreSQL
POSTGRES_DB=orz_people
POSTGRES_USER=opp
POSTGRES_PASSWORD=opptest
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=opptest
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:${REDIS_PORT}/0

# Public Form submissions: attempts allowed per Form and caller in one fixed window.
FORM_SUBMISSION_RATE_LIMIT=30
FORM_SUBMISSION_RATE_WINDOW_SECONDS=60

# Nuxt public runtime configuration (business API base; must be the backend port)
NUXT_PUBLIC_API_BASE=https://api.opp.ibuduan.com

BOOTSTRAP_CONFIRM=grant-super-admin
BOOTSTRAP_ADMIN_EMAIL=buduan461@gmail.com
