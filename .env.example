# For Development
PORT=3000
NUXT_PORT=3001

# Application ports exposed by Docker Compose
BACKEND_PORT=
FRONTEND_PORT=3001

# PostgreSQL
POSTGRES_DB=orz_people
POSTGRES_USER=orz
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# Redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-in-production
REDIS_URL=redis://:change-me-in-production@localhost:6379/0

# Nuxt public runtime configuration
NUXT_PUBLIC_API_BASE=http://localhost:3000

# Authentication (set secure random values before starting the backend)
JWT_SECRET=
JWT_ISSUER=orz-people-platform
JWT_AUDIENCE=orz-people-platform-api
JWT_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_OTP_TTL_SECONDS=600
AUTH_CHALLENGE_TTL_SECONDS=300
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_HMAC_SECRET=
TOTP_ENCRYPTION_KEY=
TOTP_PERIOD_SECONDS=30
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Orz People Platform
WEBAUTHN_ORIGINS=http://localhost:3001
DEFAULT_WORKSPACE_ID=1
